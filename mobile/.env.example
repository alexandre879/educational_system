# Optional. In development the app finds the backend on the computer running
# `npx expo start` (port 8000) by itself — start Django with:
#   python manage.py runserver 0.0.0.0:8000
# Uncomment only to use a different backend (e.g. the deployed one):
# EXPO_PUBLIC_API_URL=https://example.com/back/api

# Crash reporting; leave unset to keep it off (see README → Crash reporting).
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
