# Copy to backend/.env for local development. Never commit real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me
# 1 for local development (default), 0 in production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Your LAN IP, so phones on the same network can reach the dev servers (optional)
NET_IP=

# --- Database (either DATABASE_URL or the DB_* variables) ---
DATABASE_URL=
DB_NAME=django_db
DB_USER=django_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Telegram bot / OTP login ---
BOT_TOKEN=
# Seconds an OTP stays valid
OTP_TIMEOUT=300
# Seconds a user must wait before requesting another OTP
OTP_RATE_LIMIT=30
# Wrong guesses allowed per OTP
OTP_MAX_ATTEMPTS=5

# --- Mobile app ---
# Days a login lasts without opening the app (refresh tokens rotate on every refresh)
REFRESH_TOKEN_LIFETIME_DAYS=30
PUSH_NOTIFICATIONS_ENABLED=1
# Only needed if "enhanced push security" is turned on for the Expo project
EXPO_ACCESS_TOKEN=

# --- AI support (DeepSeek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_SUPPORT_RATE=60/hour

# --- S3 media storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=
AWS_STORAGE_BUCKET_NAME=
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
LOCATION_FOLDER_FOR_USER_PIC=profile_pics/
LOCATION_FOLDER_FOR_SUBJECT_BOOK=subject_books/

# --- Admin-only bulk student import: secret URL path, e.g. "internal/students/bulk/" (disabled if empty) ---
FOR_STUDENTS_API=

# --- Crash reporting (Sentry); leave empty to turn it off ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- This computer's network IP for phones on the same Wi-Fi; set by ../set-dev-ip.sh ---
NET_IP=
