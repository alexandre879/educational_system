# Copy to .env (or let ../set-dev-ip.sh write it) and adjust.

# The Django API. ../set-dev-ip.sh sets this to this computer's network IP so phones can use the site too.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional crash reporting (Sentry project DSN). Leave empty to turn it off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
